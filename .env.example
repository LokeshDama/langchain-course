# OpenAI — the model provider used by every example (see models.py).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# LangSmith — optional tracing and observability. Uncomment to trace runs.
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=agent-harnesses
# Non-US region? Uncomment your endpoint:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC
